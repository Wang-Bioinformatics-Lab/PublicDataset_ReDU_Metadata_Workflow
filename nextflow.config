conda.enabled = true
conda.useMamba = true
conda.cacheDir = "./conda"

trace {
    enabled = true
    file = 'trace.txt'
    overwrite = true
}

report {
    enabled = true
    file = 'report.html'
    overwrite = true
}

timeline {
    enabled = true
    file = 'timeline.html'
    overwrite = true
}

// Python's string hashing is randomised per process; a fixed seed keeps set/dict-order-dependent
// steps reproducible from run to run
env {
    PYTHONHASHSEED = '0'
}
